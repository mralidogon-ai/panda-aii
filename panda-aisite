<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="Panda AI - Seninle konuşan, öğrettiklerini öğrenen Panda yapay zekası.">
<meta name="keywords" content="Panda AI, yapay zeka, sohbet AI, Panda">
<title>Panda AI 🐼</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:linear-gradient(135deg,#e9f5e8,#fff);color:#161616}
header.site-head{height:72px;padding:0 6%;display:flex;align-items:center;justify-content:space-between;background:#111;color:white;position:sticky;top:0;z-index:5}
.brand{font-size:24px;font-weight:800}.brand span{font-size:31px;margin-right:8px}
nav a{color:#ddd;text-decoration:none;margin-left:20px;font-size:14px}
.hero{min-height:calc(100vh - 72px);display:flex;align-items:center;justify-content:center;text-align:center;padding:40px 20px}
.card{max-width:760px;background:#fff;padding:55px 35px;border-radius:32px;box-shadow:0 20px 70px #0002}
.panda{font-size:85px}.title{font-size:clamp(42px,9vw,78px);margin:10px 0}.title span{color:#2c7a3f}
.desc{font-size:18px;color:#555;line-height:1.6;max-width:600px;margin:0 auto 30px}
.btn{display:inline-block;background:#111;color:white;text-decoration:none;border:0;border-radius:17px;padding:16px 28px;font-weight:700;font-size:16px;cursor:pointer}
.info{margin-top:30px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap}.pill{background:#f0f4f0;padding:10px 14px;border-radius:14px;font-size:13px}
footer{text-align:center;padding:25px;color:#777;font-size:12px}
#pandaApp{display:none;min-height:100vh;align-items:center;justify-content:center;padding:20px}
#pandaApp .app{width:min(720px,95vw);height:min(820px,94vh);background:white;border-radius:28px;box-shadow:0 18px 60px #0002;display:flex;flex-direction:column;overflow:hidden}
#pandaApp header{background:#111;color:#fff;padding:20px 24px;display:flex;align-items:center;gap:14px}
#pandaApp .logo{font-size:42px}#pandaApp .title2{font-size:24px;font-weight:700}#pandaApp .sub{font-size:13px;opacity:.7;margin-top:3px}
#pandaApp #chat{flex:1;overflow:auto;padding:20px;background:#f7faf7}
#pandaApp .msg{display:flex;margin:12px 0}#pandaApp .msg.user{justify-content:flex-end}
#pandaApp .bubble{max-width:78%;padding:13px 16px;border-radius:18px;line-height:1.4;white-space:pre-wrap;word-wrap:break-word}
#pandaApp .ai .bubble{background:#fff;border:1px solid #e2e8e2;border-bottom-left-radius:5px}
#pandaApp .user .bubble{background:#1d1d1d;color:#fff;border-bottom-right-radius:5px}
#pandaApp .inputbar{display:flex;gap:10px;padding:14px;border-top:1px solid #ddd;background:#fff}
#pandaApp input{flex:1;border:1px solid #ccc;border-radius:16px;padding:14px;font-size:16px;outline:none}
#pandaApp input:focus{border-color:#111}
#pandaApp button{border:0;border-radius:16px;background:#111;color:#fff;padding:0 20px;font-size:15px;font-weight:700;cursor:pointer}
#pandaApp button:hover{opacity:.88}
#pandaApp .tools{display:flex;gap:8px;padding:0 14px 14px;background:#fff}
#pandaApp .tool{background:#eee;color:#222;padding:8px 12px;border-radius:12px;font-size:12px}
#pandaApp #teachPanel{display:none;padding:0 14px 14px;background:#fff}
#pandaApp .teach-row{display:grid;grid-template-columns:1fr 1fr auto;gap:8px;margin:8px 0;align-items:center}
#pandaApp .teach-row input{min-width:0}
#pandaApp .removeTeach{background:#eee;color:#222;width:42px;padding:0;height:44px;border-radius:12px}
@media(max-width:600px){nav{display:none}#pandaApp .teach-row{grid-template-columns:1fr;}#pandaApp .removeTeach{width:100%}}
</style>
</head>
<body>
<div id="homePage">
<header class="site-head">
  <div class="brand"><span>🐼</span>Panda AI</div>
  <nav><a href="#home">Ana Sayfa</a><a href="#about">Hakkında</a></nav>
</header>
<main class="hero" id="home">
<section class="card">
  <div class="panda">🐼</div>
  <h1 class="title">Panda <span>AI</span></h1>
  <p class="desc">Seninle konuşan, öğrettiklerini öğrenen ve zamanla birlikte geliştirilebilen Panda AI.</p>
  <button class="btn" id="openPanda">🐼 Panda AI'yi Aç</button>
  <div class="info">
    <div class="pill">💬 Sohbet</div><div class="pill">🧠 Öğretilebilir</div><div class="pill">🌐 Online sisteme hazır</div>
  </div>
</section>
</main>
<footer id="about">Panda AI 🐼 — Ortak öğrenme sistemi için hazırlanmıştır.</footer>
</div>

<div id="pandaApp">
  <div class="app">
    <header>
      <div class="logo">🐼</div>
      <div><div class="title2">Panda AI</div><div class="sub">Seninle konuşan ve cevapları öğrenen panda</div></div>
    </header>
    <div id="chat"></div>
    <div class="tools">
      <button class="tool" id="teachBtn">🐼 Öğret</button>
      <button class="tool" id="clearBtn">Sohbeti temizle</button>
      <button class="tool" id="memoryBtn">Öğrendiklerini sil</button>
    </div>
    <div id="teachPanel">
      <div style="border:1px solid #ddd;border-radius:18px;padding:14px;background:#fafcfa;">
        <div style="font-weight:700;margin-bottom:5px;">🐼 Panda AI'yi Öğret</div>
        <div style="font-size:12px;color:#666;margin-bottom:12px;">Soldaki alana Panda'ya söyleyeceğin <b>Cevap</b>, sağdaki alana vereceği <b>Yanıt</b>ı yaz.</div>
        <div id="teachRows"></div>
        <div style="display:flex;gap:8px;margin-top:10px;">
          <button class="tool" id="addTeachBtn">＋ Yeni Öğretme</button>
          <button class="tool" id="saveTeachBtn">💾 Kaydet</button>
        </div>
      </div>
    </div>
    <div class="inputbar">
      <input id="input" placeholder="Panda'ya bir şey yaz..." autocomplete="off">
      <button id="send">Gönder</button>
    </div>
  </div>
</div>

<script>
const homePage=document.getElementById("homePage");
const pandaApp=document.getElementById("pandaApp");
document.getElementById("openPanda").onclick=()=>{homePage.style.display="none";pandaApp.style.display="flex";input.focus();history.replaceState(null,"","#panda");};
window.addEventListener("hashchange",()=>{if(location.hash!="#panda"){homePage.style.display="block";pandaApp.style.display="none"}});

const chat = document.getElementById("chat");
const input = document.getElementById("input");
const send = document.getElementById("send");

let memory = JSON.parse(localStorage.getItem("pandaMemory") || "{}");
let history = JSON.parse(localStorage.getItem("pandaHistory") || "[]");

function save(){
  localStorage.setItem("pandaMemory", JSON.stringify(memory));
  localStorage.setItem("pandaHistory", JSON.stringify(history));
}

function addMsg(text, who, persist=true){
  const row=document.createElement("div");
  row.className="msg "+who;
  const bubble=document.createElement("div");
  bubble.className="bubble";
  bubble.textContent=text;
  row.appendChild(bubble);
  chat.appendChild(row);
  chat.scrollTop=chat.scrollHeight;
  if(persist){
    history.push({text,who});
    save();
  }
}

function normalize(s){
  return s.toLowerCase()
    .replaceAll("ı","i").replaceAll("İ","i").replaceAll("ş","s")
    .replaceAll("ğ","g").replaceAll("ü","u").replaceAll("ö","o")
    .replaceAll("ç","c").trim();
}

function answer(message){
  const m=normalize(message);

  // Öğrenme komutu: "şunu ... diye cevapla"
  const learn=m.match(/(.+?) (diye )?(cevapla|yanitla|de)$/i);
  if (learn && m.includes("diye")) {
    return "Tamam 🐼 Bunu hatırlayacağım.";
  }

  // Basit anlama kuralları
  if(/^(merhaba|selam|selaam|hey|sa)\b/.test(m))
    return "Selam! 🐼 Ben Panda AI. Bana ne konuşmak istediğini yaz!";
  if(m.includes("nasilsin") || m.includes("naber"))
    return "Ben iyiyim! 🐼 Seninle konuşunca daha da iyi oluyorum.";
  if(m.includes("kimsin") || m.includes("adın ne"))
    return "Ben Panda AI'yım 🐼 Yazdığın mesajlara göre cevap verebilen küçük bir panda yapay zekâsıyım.";
  if(m.includes("tesekkur") || m.includes("sagol"))
    return "Rica ederim! 🐼";
  if(m.includes("seni seviyorum"))
    return "Ben de seni seviyorum! 🐼❤️";
  if(m.includes("minecraft"))
    return "Minecraft mı? 🐼⛏️ Ne yapmak istediğini anlat, birlikte düşünelim.";
  if(m.includes("yardim"))
    return "Tabii! 🐼 Bana bir soru veya yapmak istediğin şeyi yaz.";

  // Kullanıcının daha önce öğrettiği anahtar kelimeler
  for(const key of Object.keys(memory)){
    if(m.includes(key)) return memory[key];
  }

  return "Hmm... 🐼 Bunu henüz bilmiyorum. Bana öğretebilirsin: \"[mesaj] için [cevap] diye cevap ver\"";
}

function sendMsg(){
  const text=input.value.trim();
  if(!text) return;

  addMsg(text,"user");

  // Özel öğrenme formatı:
  // "merhaba dediğimde selam de"
  const learnMatch=text.match(/^(.+?) dediğimde (.+?) de$/i);
  if(learnMatch){
    const key=normalize(learnMatch[1]);
    const val=learnMatch[2];
    memory[key]=val;
    save();
    addMsg("Tamam! 🐼 \""+learnMatch[1]+"\" dediğinde \""+val+"\" diye cevap vereceğim.","ai");
  }else{
    setTimeout(()=>addMsg(answer(text),"ai"),180);
  }
  input.value="";
}

const teachBtn = document.getElementById("teachBtn");
const teachPanel = document.getElementById("teachPanel");
const teachRows = document.getElementById("teachRows");
const addTeachBtn = document.getElementById("addTeachBtn");
const saveTeachBtn = document.getElementById("saveTeachBtn");

function addTeachRow(key="", val=""){
  const row = document.createElement("div");
  row.className = "teach-row";
  row.innerHTML = `
    <input class="teach-key" placeholder="Cevap / yazılacak söz" value="${escapeHtml(key)}">
    <input class="teach-val" placeholder="Yanıt / Panda'nın cevabı" value="${escapeHtml(val)}">
    <button class="removeTeach" title="Sil">✕</button>`;
  row.querySelector(".removeTeach").onclick = () => row.remove();
  teachRows.appendChild(row);
}

function escapeHtml(s){
  return String(s).replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll('"',"&quot;");
}

function openTeachPanel(){
  teachPanel.style.display = teachPanel.style.display === "none" ? "block" : "none";
  if(teachPanel.style.display === "block" && !teachRows.children.length) addTeachRow();
}

teachBtn.onclick = openTeachPanel;
addTeachBtn.onclick = () => addTeachRow();

saveTeachBtn.onclick = () => {
  let count = 0;
  [...teachRows.children].forEach(row => {
    const key = normalize(row.querySelector(".teach-key").value);
    const val = row.querySelector(".teach-val").value.trim();
    if(key && val){
      memory[key] = val;
      count++;
    }
  });
  save();
  addMsg(count ? `Tamam! 🐼 ${count} yeni öğretme kaydedildi.` : "Önce Cevap ve Yanıt alanlarını doldur. 🐼", "ai");
};

send.onclick=sendMsg;
input.addEventListener("keydown",e=>{if(e.key==="Enter")sendMsg()});

document.getElementById("clearBtn").onclick=()=>{
  history=[];
  save();
  chat.innerHTML="";
  addMsg("Sohbet temizlendi. 🐼 Baştan başlayabiliriz.","ai");
};
document.getElementById("memoryBtn").onclick=()=>{
  memory={};
  save();
  addMsg("Öğrendiğim özel cevapları sildim. 🐼","ai");
};

if(history.length){
  history.forEach(x=>addMsg(x.text,x.who,false));
}else{
  addMsg("Merhaba! Ben Panda AI 🐼 Bana istediğini yaz. Beni yeni cevaplar öğreterek geliştirebilirsin!","ai");
}

</script>
</body>
</html>
